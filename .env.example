# ---------------------------------------------------------------------------
# Swayam Swasti — customer app configuration
# Copy this file to `.env` and fill in your own values.
#
# Leave VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY EMPTY to run the app in
# local demo mode (all data stays in the browser, nothing is sent anywhere).
# ---------------------------------------------------------------------------

# Supabase project URL — Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase publishable/anon key — safe for the browser ONLY because every
# table is protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Your existing booking website (the customer app links out to it, it is not modified)
VITE_BOOKING_SITE_URL=

# Your existing admin dashboard (linked for staff, not modified)
VITE_ADMIN_DASHBOARD_URL=

# Optional support contact shown in the footer
VITE_SUPPORT_EMAIL=
