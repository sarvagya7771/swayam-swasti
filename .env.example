# ============================================================================
# Swayam Swasti Spirituality — required environment variables
#
# Copy to `.env` for local development, and add the same two values to the
# hosting environment (Settings → Environment) before publishing.
#
# Both values come from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
#   VITE_SUPABASE_URL       = Project URL          (e.g. https://abcd1234.supabase.co)
#   VITE_SUPABASE_ANON_KEY  = "anon" / publishable key (safe for browsers)
#
# NEVER put the `service_role` / secret key in this file or in any VITE_
# variable: anything prefixed with VITE_ is bundled into the public JavaScript.
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
