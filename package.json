{
  "name": "swayam-swasti-customer-app",
  "private": true,
  "version": "1.0.0",
  "description": "Swayam Swasti Spirituality — customer app (profiles, bookings, testimonials, guidance)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "check:env": "node scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
